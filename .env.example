# App
APP_ENV=local
BACKEND_PORT=8000
MAX_AUDIO_SECONDS=120
MAX_AUDIO_MB=25
ENABLE_LOCAL_FILE_STORAGE=true
AUDIO_RETENTION_MINUTES=60
DEMO_MODE=false

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# ElevenLabs
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_ID=replace_with_your_cloned_voice_id
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Guardrails
REQUIRE_VOICE_CONSENT=true
BLOCK_IMPERSONATION=true
ENABLE_CONTENT_MODERATION=true
ENABLE_AUDIO_WATERMARK_DISCLOSURE=true
